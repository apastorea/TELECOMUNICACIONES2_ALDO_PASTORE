APPLICATION = telosb_sensor
BOARD ?= telosb
RIOTBASE ?= $(CURDIR)/../../..

INCLUDES += -I$(APPDIR)

USEMODULE += cc2420
USEMODULE += test_utils_netdev_ieee802154_minimal
USEMODULE += xtimer

CFLAGS += -DEVENT_THREAD_STACKSIZE_DEFAULT=1024

NODE_ID ?= 1
NEXT_HOP_ID ?= 2
FINAL_DEST_ID ?= 3
INITIAL_TTL ?= 2
TX_INTERVAL_MS ?= 1000
CSMA ?= 1

CFLAGS += -DNODE_ID=$(NODE_ID)
CFLAGS += -DNEXT_HOP_ID=$(NEXT_HOP_ID)
CFLAGS += -DFINAL_DEST_ID=$(FINAL_DEST_ID)
CFLAGS += -DINITIAL_TTL=$(INITIAL_TTL)
CFLAGS += -DTX_INTERVAL_MS=$(TX_INTERVAL_MS)
CFLAGS += -DCSMA_ENABLED=$(CSMA)

include $(RIOTBASE)/Makefile.include
